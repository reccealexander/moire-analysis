# --- Generated data (regenerable, large) ---

# Preprocessed Gwyddion files (~512 MB). Fully regenerable from the raw .ibw
# acquisitions with:  python3 scripts/moire_prep.py ~/Downloads/<sample>
gwy/

# Copy of the published paper SI (~28 MB binary, not our content).
reference/

# Raw microscope acquisitions live outside this folder (~/Downloads) and are
# never written here, but guard against a stray copy landing in the repo.
*.ibw

